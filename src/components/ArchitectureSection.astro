---
import specs from '../content/specs.json';
---

<section class="section architecture-section graticule-bg" id="architecture" aria-labelledby="arch-title">
  <div class="container">
    <div class="reveal">
      <span class="section-label">02 // Decision Engineering</span>
      <h2 id="arch-title" class="section-heading">Architecture Selection: 4 Concepts Evaluated</h2>
      <p class="section-desc">
        To determine the physical arrangement of magnetic forces, four propulsion-levitation architectures were systematically scored across 27 distinct engineering criteria including controllability, current demand, thermal overhead, cabling burden, and scalability.
      </p>
    </div>

    <!-- Cards comparing the 4 concepts -->
    <div class="arch-cards grid-4 reveal">
      {specs.conceptScores.map((concept) => (
        <div class={`panel arch-card ${concept.winner ? 'arch-card--winner' : ''}`}>
          {concept.winner && (
            <div class="card-badge">
              <span class="badge badge--ok">Selected Architecture</span>
            </div>
          )}
          <div class="card-score-wrap">
            <span class="score-number mono">{concept.score}</span>
            <span class="score-label mono">/ 100 PTS</span>
          </div>
          <h3 class="card-arch-name">{concept.architecture}</h3>
          <p class="card-arch-desc">{concept.description}</p>
        </div>
      ))}
    </div>

    <!-- Expandable full criteria matrix -->
    <div class="criteria-accordion reveal">
      <details class="criteria-details">
        <summary class="criteria-summary">
          <span class="mono">// VIEW DETAILED EVALUATION CRITERIA MATRIX (9 KEY PARAMETERS SHOWN)</span>
          <span class="summary-arrow mono">▾</span>
        </summary>
        
        <div class="criteria-table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Evaluation Parameter</th>
                <th class="highlight">PM Mover + EM Track (Selected)</th>
                <th>PM Both Sides</th>
                <th>EM Mover + PM Track</th>
                <th>EM Both Sides</th>
              </tr>
            </thead>
            <tbody>
              {specs.conceptCriteria.map((c) => (
                <tr>
                  <td>{c.criterion}</td>
                  <td class="highlight mono">{c.winner} / 3</td>
                  <td class="mono">{c.pm_both} / 3</td>
                  <td class="mono">{c.em_carriage_track} / 3</td>
                  <td class="mono">{c.em_both} / 3</td>
                </tr>
              ))}
              <tr class="total-row">
                <td><strong>Comprehensive Overall Score</strong></td>
                <td class="highlight mono"><strong>73 / 100</strong></td>
                <td class="mono"><strong>60 / 100</strong></td>
                <td class="mono"><strong>56 / 100</strong></td>
                <td class="mono"><strong>52 / 100</strong></td>
              </tr>
            </tbody>
          </table>
          <p class="matrix-footnote mono">
            Scored 1 (Poor) to 3 (Optimal). Total sums incorporate all 27 weighted system constraints from the concept selection matrix.
          </p>
        </div>
      </details>
    </div>
    <!-- Enhanced Hardware Circuit & Track Architecture Schematic (from Excalidraw / Obsidian design) -->
    <div class="panel schematic-panel reveal">
      <div class="schematic-header">
        <div>
          <span class="mono section-label">// DETAILED ELECTRICAL & HARDWARE ARCHITECTURE</span>
          <h3 class="schematic-title">Track Circuit & I/O Commutation Schematic</h3>
          <p class="schematic-sub mono">
            Comprehensive power routing, driver matrix, and sensor topology: 230V AC mains → 24V/41A SMPS → 50A Fuse & E-Stop → DC Terminal Block & Ground Bus → 5 H-Bridge Drivers with inline current monitoring → Dual-rail stator coils with interlaced NTC thermistors and A3144 Hall-effect position sensors, governed by an STM32F411 Black Pill and I/O Expansion Module.
          </p>
        </div>
        <div class="schematic-legend mono">
          <div class="leg-item"><span class="leg-line leg-track"></span><span>Dual Track Rail</span></div>
          <div class="leg-item"><span class="leg-line leg-vcc"></span><span>24V / 5V VCC</span></div>
          <div class="leg-item"><span class="leg-line leg-gnd"></span><span>Common GND</span></div>
          <div class="leg-item"><span class="leg-line leg-ctrl"></span><span>Control / Sense IN</span></div>
          <div class="leg-item"><span class="leg-line leg-curr"></span><span>Current Loop</span></div>
        </div>
      </div>

      <!-- Vector Interactive Schematic SVG -->
      <div class="schematic-svg-scroll">
        <svg class="schematic-svg" viewBox="0 0 1100 680" preserveAspectRatio="xMidYMid meet" aria-label="Detailed electrical architecture and sensor track schematic">
          <defs>
            <filter id="glow-p" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
            <marker id="arrow-vcc" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
              <path d="M0,0 L0,6 L6,3 z" fill="#ffb830" />
            </marker>
            <marker id="arrow-ctrl" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
              <path d="M0,0 L0,6 L6,3 z" fill="#3b82f6" />
            </marker>
          </defs>

          <!-- ================= BACKGROUND GRATICULE SUB-GRID ================= -->
          <pattern id="circuit-grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--graticule)" stroke-width="0.5"/>
          </pattern>
          <rect width="1100" height="680" fill="url(#circuit-grid)" opacity="0.6"/>

          <!-- ================= 1. PRIMARY POWER STAGE (TOP LEFT) ================= -->
          <!-- 230V AC Mains Symbol -->
          <circle cx="55" cy="110" r="18" fill="var(--glass-deep)" stroke="#818cf8" stroke-width="2"/>
          <path d="M 47 110 Q 51 103 55 110 Q 59 117 63 110" fill="none" stroke="#818cf8" stroke-width="2"/>
          <text x="55" y="80" fill="#818cf8" font-family="var(--font-mono)" font-size="12" font-weight="700" text-anchor="middle">230V AC</text>
          <text x="55" y="142" fill="var(--ink-caption)" font-family="var(--font-mono)" font-size="9" text-anchor="middle">MAINS</text>

          <!-- Earth Ground -->
          <line x1="55" y1="128" x2="55" y2="150" stroke="#818cf8" stroke-width="1.5"/>
          <line x1="45" y1="150" x2="65" y2="150" stroke="#818cf8" stroke-width="2"/>
          <line x1="49" y1="154" x2="61" y2="154" stroke="#818cf8" stroke-width="1.5"/>
          <line x1="53" y1="158" x2="57" y2="158" stroke="#818cf8" stroke-width="1"/>

          <!-- Line from AC to SMPS -->
          <line x1="73" y1="102" x2="105" y2="102" stroke="#818cf8" stroke-width="2"/>

          <!-- SMPS 24V / 41A Unit -->
          <rect x="105" y="80" width="105" height="55" rx="4" fill="var(--glass-deep)" stroke="#818cf8" stroke-width="1.8"/>
          <text x="157" y="102" fill="var(--ink-primary)" font-family="var(--font-mono)" font-size="11" font-weight="700" text-anchor="middle">SMPS</text>
          <text x="157" y="120" fill="#ffb830" font-family="var(--font-mono)" font-size="10" text-anchor="middle">24V / 41A</text>

          <!-- SMPS Output line to Main Fuse -->
          <path d="M 210 100 L 290 100 L 310 70 L 370 70" fill="none" stroke="#ffb830" stroke-width="2"/>

          <!-- Main FUSE (41A) -->
          <rect x="370" y="52" width="85" height="36" rx="3" fill="var(--glass-deep)" stroke="#f87171" stroke-width="1.8"/>
          <text x="412" y="68" fill="#f87171" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="middle">MAIN FUSE</text>
          <text x="412" y="81" fill="var(--ink-caption)" font-family="var(--font-mono)" font-size="9" text-anchor="middle">(41A / 50A)</text>

          <!-- Line to Main Switch -->
          <line x1="455" y1="70" x2="495" y2="70" stroke="#ffb830" stroke-width="2"/>

          <!-- Main Switch -->
          <rect x="495" y="52" width="75" height="36" rx="3" fill="var(--glass-deep)" stroke="#ffb830" stroke-width="1.8"/>
          <text x="532" y="68" fill="var(--ink-primary)" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="middle">MAIN</text>
          <text x="532" y="81" fill="#ffb830" font-family="var(--font-mono)" font-size="9" text-anchor="middle">SWITCH</text>

          <!-- Line to 24V Distribution Block -->
          <line x1="570" y1="70" x2="615" y2="70" stroke="#ffb830" stroke-width="2"/>

          <!-- 24V DC Distribution Terminal Block -->
          <rect x="615" y="45" width="145" height="50" rx="4" fill="var(--glass-deep)" stroke="#ffb830" stroke-width="2"/>
          <text x="687" y="66" fill="#ffb830" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="middle">24V DC DISTRIBUTION</text>
          <text x="687" y="82" fill="var(--ink-secondary)" font-family="var(--font-mono)" font-size="9" text-anchor="middle">TERMINAL BLOCK</text>

          <!-- Ground BUS -->
          <rect x="830" y="48" width="130" height="42" rx="4" fill="var(--glass-deep)" stroke="#22c55e" stroke-width="1.8"/>
          <text x="895" y="73" fill="#22c55e" font-family="var(--font-mono)" font-size="11" font-weight="700" text-anchor="middle">GROUND BUS</text>

          <!-- GND Trunk Line across the circuit -->
          <path d="M 895 90 L 895 210 L 980 210 L 980 500 L 700 500" fill="none" stroke="#22c55e" stroke-width="1.6" stroke-dasharray="4 3"/>

          <!-- Buck Converter (24V -> 5V/10A) -->
          <rect x="45" y="270" width="115" height="48" rx="4" fill="var(--glass-deep)" stroke="#38bdf8" stroke-width="1.8"/>
          <text x="102" y="290" fill="#38bdf8" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="middle">BUCK CONVERTER</text>
          <text x="102" y="306" fill="var(--ink-caption)" font-family="var(--font-mono)" font-size="9" text-anchor="middle">24V → 5V / 10A</text>

          <!-- Power into Buck from 24V line -->
          <path d="M 660 95 L 660 170 L 30 170 L 30 294 L 45 294" fill="none" stroke="#ffb830" stroke-width="1.5"/>

          <!-- ================= 2. DUAL TRACK STATOR RAILS (HORIZONTAL) ================= -->
          <!-- Top Track Rail -->
          <rect x="230" y="325" width="670" height="8" rx="2" fill="#818cf8" opacity="0.8"/>
          <text x="210" y="332" fill="#818cf8" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="end">UPPER RAIL</text>

          <!-- Bottom Track Rail -->
          <rect x="230" y="415" width="670" height="8" rx="2" fill="#818cf8" opacity="0.8"/>
          <text x="210" y="422" fill="#818cf8" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="end">LOWER RAIL</text>

          <!-- Track Travel Direction / Mover Clearance -->
          <text x="565" y="375" fill="var(--phosphor-dim)" font-family="var(--font-mono)" font-size="10" letter-spacing="0.2em" text-anchor="middle">‹‹ PASSIVE PERMANENT-MAGNET MOVER AIR GAP (2–3mm) ››</text>

          <!-- ================= 3. COIL & SENSOR STAGES ALONG RAILS ================= -->

          <!-- Stage 0: Leftmost Lift / Aux Stage -->
          <rect x="180" y="270" width="75" height="38" rx="3" fill="var(--glass-deep)" stroke="#fb923c" stroke-width="1.5"/>
          <text x="217" y="293" fill="#fb923c" font-family="var(--font-mono)" font-size="10" font-weight="700" text-anchor="middle">H-BRIDGE</text>

          <!-- Left Aux Coil Upper -->
          <g transform="translate(240, 290)">
            <rect x="0" y="0" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5" filter="url(#glow-p)"/>
            <path d="M 10 5 Q 23 2 36 5 M 10 14 Q 23 11 36 14 M 10 23 Q 23 20 36 23" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <!-- NTC Temp Sensor -->
            <rect x="15" y="-18" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="23" y="-8" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>
          </g>

          <!-- Left Aux Coil Lower -->
          <g transform="translate(240, 435)">
            <rect x="0" y="0" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 10 5 Q 23 2 36 5 M 10 14 Q 23 11 36 14 M 10 23 Q 23 20 36 23" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="15" y="32" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="23" y="42" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>
          </g>

          <!-- Left Current Sensor for Stage 0 -->
          <rect x="235" y="200" width="68" height="34" rx="3" fill="var(--glass-deep)" stroke="#38bdf8" stroke-width="1.5"/>
          <text x="269" y="215" fill="#38bdf8" font-family="var(--font-mono)" font-size="8" font-weight="700" text-anchor="middle">CURRENT</text>
          <text x="269" y="227" fill="#38bdf8" font-family="var(--font-mono)" font-size="8" text-anchor="middle">SENSOR</text>

          <!-- Repeating Propulsion Stages 1 to 4 -->
          <!-- Array of 4 Driver Modules on Upper Rail -->
          <!-- Stage 1 -->
          <g transform="translate(370, 0)">
            <rect x="0" y="170" width="62" height="30" rx="3" fill="var(--glass-deep)" stroke="#38bdf8" stroke-width="1.5"/>
            <text x="31" y="184" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" font-weight="700" text-anchor="middle">CURRENT</text>
            <text x="31" y="194" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">SENSOR</text>

            <rect x="-8" y="210" width="78" height="32" rx="3" fill="var(--glass-deep)" stroke="#fb923c" stroke-width="1.5"/>
            <text x="31" y="230" fill="#fb923c" font-family="var(--font-mono)" font-size="9" font-weight="700" text-anchor="middle">H-BRIDGE</text>

            <!-- Coil upper -->
            <rect x="7" y="290" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5" filter="url(#glow-p)"/>
            <path d="M 17 295 Q 30 292 43 295 M 17 304 Q 30 301 43 304 M 17 313 Q 30 310 43 313" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="272" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="282" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>

            <!-- Coil lower -->
            <rect x="7" y="435" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 440 Q 30 437 43 440 M 17 449 Q 30 446 43 449 M 17 458 Q 30 455 43 458" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="468" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="478" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>
          </g>

          <!-- Stage 2 -->
          <g transform="translate(510, 0)">
            <rect x="0" y="170" width="62" height="30" rx="3" fill="var(--glass-deep)" stroke="#38bdf8" stroke-width="1.5"/>
            <text x="31" y="184" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" font-weight="700" text-anchor="middle">CURRENT</text>
            <text x="31" y="194" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">SENSOR</text>

            <rect x="-8" y="210" width="78" height="32" rx="3" fill="var(--glass-deep)" stroke="#fb923c" stroke-width="1.5"/>
            <text x="31" y="230" fill="#fb923c" font-family="var(--font-mono)" font-size="9" font-weight="700" text-anchor="middle">H-BRIDGE</text>

            <rect x="7" y="290" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 295 Q 30 292 43 295 M 17 304 Q 30 301 43 304 M 17 313 Q 30 310 43 313" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="272" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="282" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>

            <rect x="7" y="435" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 440 Q 30 437 43 440 M 17 449 Q 30 446 43 449 M 17 458 Q 30 455 43 458" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="468" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="478" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>
          </g>

          <!-- Stage 3 -->
          <g transform="translate(650, 0)">
            <rect x="0" y="170" width="62" height="30" rx="3" fill="var(--glass-deep)" stroke="#38bdf8" stroke-width="1.5"/>
            <text x="31" y="184" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" font-weight="700" text-anchor="middle">CURRENT</text>
            <text x="31" y="194" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">SENSOR</text>

            <rect x="-8" y="210" width="78" height="32" rx="3" fill="var(--glass-deep)" stroke="#fb923c" stroke-width="1.5"/>
            <text x="31" y="230" fill="#fb923c" font-family="var(--font-mono)" font-size="9" font-weight="700" text-anchor="middle">H-BRIDGE</text>

            <rect x="7" y="290" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 295 Q 30 292 43 295 M 17 304 Q 30 301 43 304 M 17 313 Q 30 310 43 313" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="272" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="282" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>

            <rect x="7" y="435" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 440 Q 30 437 43 440 M 17 449 Q 30 446 43 449 M 17 458 Q 30 455 43 458" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="468" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="478" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>
          </g>

          <!-- Stage 4 -->
          <g transform="translate(790, 0)">
            <rect x="0" y="170" width="62" height="30" rx="3" fill="var(--glass-deep)" stroke="#38bdf8" stroke-width="1.5"/>
            <text x="31" y="184" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" font-weight="700" text-anchor="middle">CURRENT</text>
            <text x="31" y="194" fill="#38bdf8" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">SENSOR</text>

            <rect x="-8" y="210" width="78" height="32" rx="3" fill="var(--glass-deep)" stroke="#fb923c" stroke-width="1.5"/>
            <text x="31" y="230" fill="#fb923c" font-family="var(--font-mono)" font-size="9" font-weight="700" text-anchor="middle">H-BRIDGE</text>

            <rect x="7" y="290" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 295 Q 30 292 43 295 M 17 304 Q 30 301 43 304 M 17 313 Q 30 310 43 313" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="272" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="282" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>

            <rect x="7" y="435" width="46" height="28" rx="3" fill="#142814" stroke="var(--phosphor)" stroke-width="1.5"/>
            <path d="M 17 440 Q 30 437 43 440 M 17 449 Q 30 446 43 449 M 17 458 Q 30 455 43 458" stroke="var(--phosphor)" stroke-width="1.5" fill="none"/>
            <rect x="22" y="468" width="16" height="14" fill="#ea580c" rx="2"/>
            <text x="30" y="478" fill="#fff" font-family="var(--font-mono)" font-size="7" font-weight="700" text-anchor="middle">NTC</text>
          </g>

          <!-- Hall Effect Sensors interspaced between coils on lower rail -->
          { [325, 465, 605, 745].map((pos) => (
            <g transform={`translate(${pos}, 430)`}>
              <rect x="0" y="0" width="22" height="26" rx="2" fill="#0f172a" stroke="#60a5fa" stroke-width="1.2"/>
              <line x1="6" y1="26" x2="6" y2="38" stroke="#60a5fa" stroke-width="1.2"/>
              <line x1="11" y1="26" x2="11" y2="38" stroke="#60a5fa" stroke-width="1.2"/>
              <line x1="16" y1="26" x2="16" y2="38" stroke="#60a5fa" stroke-width="1.2"/>
              <text x="11" y="14" fill="#60a5fa" font-family="var(--font-mono)" font-size="6.5" font-weight="700" text-anchor="middle">HALL</text>
              <text x="11" y="22" fill="var(--ink-caption)" font-family="var(--font-mono)" font-size="5.5" text-anchor="middle">A3144</text>
            </g>
          )) }

          <!-- ================= 4. CONTROLLER TIERS (BOTTOM) ================= -->

          <!-- STM32F411 Black Pill Board -->
          <g transform="translate(220, 530)">
            <rect x="0" y="0" width="200" height="95" rx="5" fill="#090d09" stroke="var(--phosphor)" stroke-width="2" filter="url(#glow-p)"/>
            <!-- USB-C Port -->
            <rect x="-16" y="32" width="16" height="30" rx="3" fill="#334155" stroke="#94a3b8" stroke-width="1.5"/>
            <!-- STM32 Chip -->
            <rect x="100" y="28" width="40" height="40" rx="2" fill="#1e293b" stroke="#64748b" transform="rotate(45 120 48)"/>
            <!-- Labels -->
            <text x="100" y="24" fill="var(--phosphor)" font-family="var(--font-display)" font-size="11" font-weight="700" text-anchor="middle">STM32F411</text>
            <text x="100" y="80" fill="var(--ink-secondary)" font-family="var(--font-mono)" font-size="8.5" text-anchor="middle">ARM CORTEX-M4 · 100MHz</text>
            <text x="100" y="90" fill="var(--amber)" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">PID CURRENT & COMMUTATION</text>
            <!-- Pin headers -->
            <line x1="10" y1="10" x2="190" y2="10" stroke="#fbbf24" stroke-dasharray="3 4" stroke-width="2"/>
            <line x1="10" y1="85" x2="190" y2="85" stroke="#fbbf24" stroke-dasharray="3 4" stroke-width="2"/>
          </g>

          <!-- Interconnect Cable Bus (SPI / I2C / GPIO) between STM32 and I/O Expander -->
