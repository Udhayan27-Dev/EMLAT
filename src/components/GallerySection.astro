---
import gallery from '../content/gallery.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section gallery-section graticule-bg" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="reveal">
      <span class="section-label">07 // Engineering Media Archive</span>
      <h2 id="gallery-title" class="section-heading">Media, Simulations & Lab Demonstrations</h2>
      <p class="section-desc">
        Visual archive of CAD animations, magnetic field kinematic simulations, carrier wheel assembly details, and bench-top electromagnetic test runs.
      </p>
    </div>

    <!-- Media Grid -->
    <div class="grid-2 gallery-grid reveal">
      {gallery.items.map((item) => (
        <div class="panel media-card">
          <div class="media-preview-wrap">
            <video
              class="media-video"
              src={`${base}${item.src}`}
              poster={`${base}${item.poster}`}
              preload="metadata"
              controls
              playsinline
              muted
            ></video>
          </div>
          <div class="media-info">
            <span class="media-type-tag mono">{item.type.toUpperCase()}</span>
            <p class="media-caption">{item.caption}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.gallery-section {
  border-top: 1px solid var(--graticule);
}

.section-heading {
  margin-bottom: var(--space-4);
}

.section-desc {
  max-width: 65ch;
  color: var(--ink-secondary);
  margin-bottom: var(--space-10);
}

.gallery-grid {
  gap: var(--space-6);
}

.media-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0;
  border-color: var(--glass-border);
  transition: border-color var(--transition-fast), transform var(--transition-fast);
}

.media-card:hover {
  border-color: var(--phosphor-dim);
  transform: translateY(-2px);
}

.media-preview-wrap {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #000;
  position: relative;
  overflow: hidden;
}

.media-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.media-info {
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  flex-grow: 1;
}

.media-type-tag {
  font-size: 0.7rem;
  color: var(--amber);
  letter-spacing: 0.1em;
}

.media-caption {
  font-size: var(--text-xs);
  color: var(--ink-primary);
  line-height: 1.5;
  margin-bottom: 0;
}
</style>
