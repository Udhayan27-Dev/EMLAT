---
import team from '../content/team.json';
---

<section class="section team-section graticule-bg" id="team" aria-labelledby="team-title">
  <div class="container">
    <div class="reveal">
      <span class="section-label">08 // Engineering Team</span>
      <h2 id="team-title" class="section-heading">Project Members & Functional Roles</h2>
      <p class="section-desc">
        Five-member multidisciplinary student engineering team covering mechanics, firmware, electrical power stages, and concept visualization.
      </p>
    </div>

    <!-- Team Cards Grid -->
    <div class="team-grid reveal">
      {team.members.map((member) => (
        <div class="panel team-card">
          <div class="monogram-badge">
            <span class="monogram-text mono">{member.initials}</span>
          </div>
          <div class="team-meta">
            <h3 class="member-name">{member.name}</h3>
            <span class="member-role mono">{member.role}</span>
            <p class="member-focus">{member.focus}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.team-section {
  border-top: 1px solid var(--graticule);
}

.section-heading {
  margin-bottom: var(--space-4);
}

.section-desc {
  max-width: 65ch;
  color: var(--ink-secondary);
  margin-bottom: var(--space-10);
}

.team-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

@media (min-width: 600px) {
  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .team-grid {
    grid-template-columns: repeat(5, 1fr);
  }
}

.team-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--space-6) var(--space-4);
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.team-card:hover {
  transform: translateY(-2px);
  border-color: var(--phosphor-dim);
}

.monogram-badge {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--glass-deep);
  border: 2px solid var(--phosphor);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-4);
  box-shadow: 0 0 12px var(--phosphor-glow);
}

.monogram-text {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--phosphor);
}

.team-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.member-name {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--ink-primary);
  font-family: var(--font-body);
  text-transform: none;
  letter-spacing: normal;
  margin-bottom: 0;
}

.member-role {
  font-size: 0.75rem;
  color: var(--amber);
  margin-bottom: var(--space-2);
}

.member-focus {
  font-size: var(--text-xs);
  color: var(--ink-caption);
  line-height: 1.4;
  margin-bottom: 0;
}
</style>
